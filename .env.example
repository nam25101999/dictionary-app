# Environment variables example for Dictionary App
# Copy this file to .env before running: cp .env.example .env

# Database Configuration
POSTGRES_DB=dictionary_db
POSTGRES_USER=dict_user
POSTGRES_PASSWORD=dict_secure_password_2026
POSTGRES_PORT=5432

# Backend Configuration
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
BACKEND_PORT=8180

# Frontend Configuration
FRONTEND_PORT=3100

# Docker & Registry (For CI/CD and production deployment)
# Replace 'your-github-username' with your actual GitHub username / organization (in lowercase)
IMAGE_REGISTRY=ghcr.io
IMAGE_OWNER=your-github-username
IMAGE_TAG=latest
